{
  "name": "chadobe-keithrobat",
  "version": "1.0.0",
  "private": true,
  "description": "A free, browser-based .PDF editor in one HTML file. Test suite.",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:engine": "node --test tests/engine.test.mjs",
